# Örnek değerler — gerçek değerleri sunucudaki backend/.env dosyasına yazın, bu dosyaya ASLA yazmayın.

# Twilio Verify (telefon doğrulama: SMS + WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# true ise ücretsiz deneme gibi akışlarda doğrulanmış telefon şart olur (varsayılan: kapalı)
TELEFON_DOGRULAMA_ZORUNLU=false
